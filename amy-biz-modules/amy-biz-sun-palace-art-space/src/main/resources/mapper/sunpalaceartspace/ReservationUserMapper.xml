<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amy.sunpalaceartspace.mapper.ReservationUserMapper">

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.ReservationUserVO" id="ReservationUserResult">
        <id property="reservationUserId" column="reservation_user_id"/>
        <result property="nickname" column="nickname"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="avatarImgUrl" column="avatar_img_url"/>
        <result property="openId" column="open_id"/>
        <result property="idNum" column="id_num"/>
        <result property="status" column="status"/>
        <result property="type" column="type"/>
        <result property="isVerified" column="is_verified"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectReservationUserVo">
        select reservation_user_id,
               nickname,
               name,
               phone,
               avatar_img_url,
               open_id,
               id_num,
               status + 0 as status,
               type,
               is_verified,
               create_time
        from biz_spas_reservation_user
    </sql>

    <!--
        分页列表：第一个参数是 MP 的 Page 对象，由 PaginationInnerInterceptor 自动改写 SQL
        完成 count + limit，本处【不要】写 limit。
        条件统一通过 @Param("entity") 传入；${entity.params.dataScope} 预留给 @DataScope 切面注入。
    -->
    <select id="selectReservationUserList" resultMap="ReservationUserResult">
        <include refid="selectReservationUserVo"/>
        <where>
            del_flag = '0'
            <if test="entity.openId != null and entity.openId != ''">
                and open_id = #{entity.openId}
            </if>
            <if test="entity.nickname != null and entity.nickname != ''">
                and nickname like concat('%', #{entity.nickname}, '%')
            </if>
            <if test="entity.name != null and entity.name != ''">
                and name like concat('%', #{entity.name}, '%')
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                and phone like concat('%', #{entity.phone}, '%')
            </if>
            <if test="entity.status != null">
                and status = #{entity.status}
            </if>
            <if test="entity.type != null">
                and type = #{entity.type}
            </if>
            <if test="entity.isVerified != null">
                and is_verified = #{entity.isVerified}
            </if>
            <!-- 注册时间范围：来自 params.beginTime / params.endTime（BaseEntity.params），值为 yyyy-MM-dd -->
            <if test="entity.params.beginTime != null and entity.params.beginTime != ''">
                and create_time &gt;= concat(#{entity.params.beginTime}, ' 00:00:00')
            </if>
            <if test="entity.params.endTime != null and entity.params.endTime != ''">
                and create_time &lt;= concat(#{entity.params.endTime}, ' 23:59:59')
            </if>
            <!-- 数据权限 -->
            <if test="entity.params.dataScope != null and entity.params.dataScope != ''">
                ${entity.params.dataScope}
            </if>
        </where>
        order by create_time desc
    </select>

    <!-- 导出列表：不分页 -->
    <select id="selectReservationUserExportList" resultMap="ReservationUserResult">
        <include refid="selectReservationUserVo"/>
        <where>
            del_flag = '0'
            <if test="entity.openId != null and entity.openId != ''">
                and open_id = #{entity.openId}
            </if>
            <if test="entity.nickname != null and entity.nickname != ''">
                and nickname like concat('%', #{entity.nickname}, '%')
            </if>
            <if test="entity.name != null and entity.name != ''">
                and name like concat('%', #{entity.name}, '%')
            </if>
            <if test="entity.phone != null and entity.phone != ''">
                and phone like concat('%', #{entity.phone}, '%')
            </if>
            <if test="entity.status != null">
                and status = #{entity.status}
            </if>
            <if test="entity.type != null">
                and type = #{entity.type}
            </if>
            <if test="entity.isVerified != null">
                and is_verified = #{entity.isVerified}
            </if>
            <!-- 注册时间范围：来自 params.beginTime / params.endTime（BaseEntity.params），值为 yyyy-MM-dd -->
            <if test="entity.params.beginTime != null and entity.params.beginTime != ''">
                and create_time &gt;= #{entity.params.beginTime}
            </if>
            <if test="entity.params.endTime != null and entity.params.endTime != ''">
                and create_time &lt;= concat(#{entity.params.endTime}, ' 23:59:59')
            </if>
            <!-- 数据权限 -->
            <if test="entity.params.dataScope != null and entity.params.dataScope != ''">
                ${entity.params.dataScope}
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectReservationUserById" parameterType="Long" resultMap="ReservationUserResult">
        <include refid="selectReservationUserVo"/>
        where reservation_user_id = #{reservationUserId} and del_flag = '0'
    </select>
</mapper>
