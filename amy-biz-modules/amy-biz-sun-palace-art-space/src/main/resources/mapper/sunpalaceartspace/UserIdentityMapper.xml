<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amy.sunpalaceartspace.mapper.UserIdentityMapper">

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.UserIdentityVO" id="UserIdentityResult">
        <id property="userIdentityId" column="user_identity_id"/>
        <result property="name" column="name"/>
        <result property="idType" column="id_type"/>
        <result property="idNum" column="id_num"/>
        <result property="gender" column="gender"/>
        <result property="phone" column="phone"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectUserIdentityVo">
        select user_identity_id,
               name,
               id_type,
               id_num,
               gender,
               phone,
               create_time
        from biz_spas_user_identity
    </sql>

    <select id="selectUserIdentityList" parameterType="com.amy.sunpalaceartspace.domain.entity.UserIdentity"
            resultMap="UserIdentityResult">
        <include refid="selectUserIdentityVo"/>
        where del_flag = '0'
        <if test="name != null and name != ''">
            and name like concat('%', #{name}, '%')
        </if>
        <if test="idType != null">
            and id_type = #{idType}
        </if>
        <if test="idNum != null and idNum != ''">
            and id_num like concat('%', #{idNum}, '%')
        </if>
        <if test="gender != null">
            and gender = #{gender}
        </if>
        <if test="phone != null and phone != ''">
            and phone like concat('%', #{phone}, '%')
        </if>
        <!-- 数据权限 -->
        ${params.dataScope}
        order by create_time desc
    </select>

    <select id="selectUserIdentityById" parameterType="Long" resultMap="UserIdentityResult">
        <include refid="selectUserIdentityVo"/>
        where user_identity_id = #{userIdentityId} and del_flag = '0'
    </select>
</mapper>
