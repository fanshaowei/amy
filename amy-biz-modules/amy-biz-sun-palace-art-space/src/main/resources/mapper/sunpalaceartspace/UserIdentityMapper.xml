<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amy.sunpalaceartspace.mapper.UserIdentityMapper">

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.UserIdentityVO" id="UserIdentityResult">
        <id property="userIdentityId" column="user_identity_id"/>
        <result property="reservationUserId" column="reservation_user_id"/>
        <result property="name" column="name"/>
        <result property="idType" column="id_type"/>
        <result property="idNum" column="id_num"/>
        <result property="gender" column="gender"/>
        <result property="phone" column="phone"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectUserIdentityVo">
        select user_identity_id,
               reservation_user_id,
               name,
               id_type,
               id_num,
               gender,
               phone,
               create_time
        from biz_spas_user_identity
    </sql>

    <!-- 列表查询条件：统一通过 @Param("entity") 传入，供分页 / 导出两个 select 复用 -->
    <sql id="selectUserIdentityWhere">
        where del_flag = '0'
        <if test="entity.reservationUserId != null">
            and reservation_user_id = #{entity.reservationUserId}
        </if>
        <if test="entity.name != null and entity.name != ''">
            and name like concat('%', #{entity.name}, '%')
        </if>
        <if test="entity.idType != null">
            and id_type = #{entity.idType}
        </if>
        <if test="entity.idNum != null and entity.idNum != ''">
            and id_num like concat('%', #{entity.idNum}, '%')
        </if>
        <if test="entity.gender != null">
            and gender = #{entity.gender}
        </if>
        <if test="entity.phone != null and entity.phone != ''">
            and phone like concat('%', #{entity.phone}, '%')
        </if>
        <!-- 数据权限（由 @DataScope 切面写入 entity.params.dataScope） -->
        <if test="entity.params != null and entity.params.dataScope != null and entity.params.dataScope != ''">
            ${entity.params.dataScope}
        </if>
    </sql>

    <!--
        分页列表：第一个参数是 MP 的 Page 对象，由 PaginationInnerInterceptor 自动改写 SQL
        完成 count + limit，本处【不要】写 limit。
    -->
    <select id="selectUserIdentityList" resultMap="UserIdentityResult">
        <include refid="selectUserIdentityVo"/>
        <include refid="selectUserIdentityWhere"/>
        order by create_time desc
    </select>

    <!-- 导出列表：不分页，独立 select，不与分页方法复用 -->
    <select id="selectUserIdentityExportList" resultMap="UserIdentityResult">
        <include refid="selectUserIdentityVo"/>
        <include refid="selectUserIdentityWhere"/>
        order by create_time desc
    </select>

    <select id="selectUserIdentityById" parameterType="Long" resultMap="UserIdentityResult">
        <include refid="selectUserIdentityVo"/>
        where user_identity_id = #{userIdentityId} and del_flag = '0'
    </select>
</mapper>
