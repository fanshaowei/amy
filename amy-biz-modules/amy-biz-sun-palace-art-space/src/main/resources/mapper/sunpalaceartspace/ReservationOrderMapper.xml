<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.amy.sunpalaceartspace.mapper.ReservationOrderMapper">

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.ReservationOrderVO" id="ReservationOrderResult">
        <id property="reservationOrderId" column="reservation_order_id"/>
        <result property="reservationNum" column="reservation_num"/>
        <result property="projectId" column="project_id"/>
        <result property="projectName" column="project_name"/>
        <result property="reservationUserId" column="reservation_user_id"/>
        <result property="reservationUserNumber" column="reservation_user_number"/>
        <result property="reservationUserName" column="reservation_user_name"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="idType" column="id_type"/>
        <result property="idNum" column="id_num"/>
        <result property="guestsNum" column="guests_num"/>
        <result property="reservationTime" column="reservation_time"/>
        <result property="reservationStatus" column="reservation_status"/>
        <result property="verifyBy" column="verify_by"/>
        <result property="verifyTime" column="verify_time"/>
        <result property="createTime" column="create_time"/>
        <!-- comp_users 是 List<String>，列存 JSON 数组字符串，必须带 typeHandler 才能正确映射到 VO 字段 -->
        <result property="compUsers" column="comp_users"
                typeHandler="com.amy.sunpalaceartspace.config.StringListJsonTypeHandler"/>
    </resultMap>

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.ReservationOrderStatisticVO" id="ReservationOrderStatisticResult">
        <result property="projectId" column="project_id"/>
        <result property="reservationDate" column="reservation_date"/>
        <result property="count" column="cnt"/>
    </resultMap>

    <sql id="selectReservationOrderVo">
        select r.reservation_order_id,
               r.reservation_num,
               r.project_id,
               p.project_name,
               r.reservation_user_id,
               u.user_number          as reservation_user_number,
               u.name                 as reservation_user_name,
               r.name,
               r.phone,
               r.id_type,
               r.id_num,
               r.guests_num,
               r.reservation_time,
               r.reservation_status + 0 as reservation_status,
               r.verify_by,
               r.verify_time,
               r.comp_users,
               r.create_time
        from biz_spas_reservation_order r
        left join biz_spas_projects p on p.project_id = r.project_id and p.del_flag = '0'
        left join biz_spas_reservation_user u on u.reservation_user_id = r.reservation_user_id and u.del_flag = '0'
    </sql>

    <select id="selectReservationOrderList" parameterType="com.amy.sunpalaceartspace.domain.entity.ReservationOrder"
            resultMap="ReservationOrderResult">
        <include refid="selectReservationOrderVo"/>
        where r.del_flag = '0'
        <if test="reservationNum != null and reservationNum != ''">
            and r.reservation_num like concat('%', #{reservationNum}, '%')
        </if>
        <if test="projectId != null">
            and r.project_id = #{projectId}
        </if>
        <if test="name != null and name != ''">
            and r.name like concat('%', #{name}, '%')
        </if>
        <if test="phone != null and phone != ''">
            and r.phone like concat('%', #{phone}, '%')
        </if>
        <if test="reservationStatus != null">
            and r.reservation_status = #{reservationStatus}
        </if>
        <if test="reservationTime != null">
            and date(r.reservation_time) = date(#{reservationTime})
        </if>
        <!-- 数据权限 -->
        ${params.dataScope}
        order by r.create_time desc
    </select>

    <select id="selectReservationOrderById" parameterType="Long" resultMap="ReservationOrderResult">
        <include refid="selectReservationOrderVo"/>
        where r.reservation_order_id = #{reservationOrderId} and r.del_flag = '0'
    </select>

    <!-- 按预约时间（日期）统计各时间段的预约订单数 -->
    <select id="selectReservationOrderStatisticByDate"
            parameterType="com.amy.sunpalaceartspace.domain.criteria.ReservationOrderStatisticCriteria"
            resultMap="ReservationOrderStatisticResult">
        select
            r.project_id as project_id,
            date_format(r.reservation_time, '%Y-%m-%d') as reservation_date,
            count(*) as cnt
        from biz_spas_reservation_order r
        where r.del_flag = '0'
        <if test="projectId != null">
            and r.project_id = #{projectId}
        </if>
        <if test="reservationTimeStart != null">
            and r.reservation_time &gt;= #{reservationTimeStart}
        </if>
        <if test="reservationTimeEnd != null">
            and r.reservation_time &lt;= #{reservationTimeEnd}
        </if>
        group by r.project_id, date_format(r.reservation_time, '%Y-%m-%d')
        order by project_id asc, reservation_date asc
    </select>

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.ReservationOrderStatisticByTimeVO" id="ReservationOrderStatisticByTimeResult">
        <result property="projectId" column="project_id"/>
        <result property="reservationDate" column="reservation_date"/>
        <result property="reservationTime" column="reservation_time_label"/>
        <result property="count" column="cnt"/>
    </resultMap>

    <!-- 按预约时间（日期+时间段）统计各时间段的预约订单数 -->
    <select id="selectReservationOrderStatisticByTime"
            parameterType="com.amy.sunpalaceartspace.domain.criteria.ReservationOrderStatisticCriteria"
            resultMap="ReservationOrderStatisticByTimeResult">
        select
            r.project_id as project_id,
            date_format(r.reservation_time, '%Y-%m-%d') as reservation_date,
            date_format(r.reservation_time, '%H:%i:%s') as reservation_time_label,
            count(*) as cnt
        from biz_spas_reservation_order r
        where r.del_flag = '0'
        <if test="projectId != null">
            and r.project_id = #{projectId}
        </if>
        <if test="reservationTimeStart != null">
            and r.reservation_time &gt;= #{reservationTimeStart}
        </if>
        <if test="reservationTimeEnd != null">
            and r.reservation_time &lt;= #{reservationTimeEnd}
        </if>
        group by r.project_id, date_format(r.reservation_time, '%Y-%m-%d'), date_format(r.reservation_time, '%H:%i:%s')
        order by project_id asc, reservation_date asc, reservation_time_label asc
    </select>

    <resultMap type="com.amy.sunpalaceartspace.domain.vo.ReservationOrderStatisticByProjectVO" id="ReservationOrderStatisticByProjectResult">
        <result property="projectId" column="project_id"/>
        <result property="count" column="cnt"/>
    </resultMap>

    <!-- 按项目分组统计预约订单总数（按日期时间范围） -->
    <select id="selectReservationOrderStatisticByProject"
            parameterType="com.amy.sunpalaceartspace.domain.criteria.ReservationOrderStatisticCriteria"
            resultMap="ReservationOrderStatisticByProjectResult">
        select
            r.project_id as project_id,
            count(*) as cnt
        from biz_spas_reservation_order r
        where r.del_flag = '0'
        <if test="projectId != null">
            and r.project_id = #{projectId}
        </if>
        <if test="reservationTimeStart != null">
            and r.reservation_time &gt;= #{reservationTimeStart}
        </if>
        <if test="reservationTimeEnd != null">
            and r.reservation_time &lt;= #{reservationTimeEnd}
        </if>
        group by r.project_id
        order by project_id asc
    </select>
</mapper>
