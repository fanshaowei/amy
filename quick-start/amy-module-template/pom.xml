<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      父模块：由 amy-module-scaffold 技能在生成时替换为目标聚合模块（amy-biz-modules / amy-modules 等）。
      relativePath 指向该聚合模块的 pom.xml。
    -->
    <parent>
        <groupId>com.amy</groupId>
        <artifactId>__PARENT_ARTIFACT__</artifactId>
        <version>3.6.8</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>__APP_ARTIFACT__</artifactId>
    <description>__APP_DESC__</description>

    <dependencies>
        <!-- ===== Spring Cloud Alibaba Nacos：服务注册发现 + 配置中心 ===== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- ===== Sentinel 流控（与 Nacos 配套） ===== -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>

        <!-- ===== Spring Boot Actuator（健康检查 / 探针） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ===== 完整 Spring Web / MVC ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ===== MySQL 驱动 ===== -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>

        <!-- ===== Redis：amy 封装的 RedisTemplate / RedisService ===== -->
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-redis</artifactId>
        </dependency>

        <!-- ===== MyBatis-Plus：单表 CRUD 零 XML ===== -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- ===== amy 公共模块 ===== -->
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-datasource</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-datascope</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-log</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-swagger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-sensitive</artifactId>
        </dependency>
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-api-system</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <!-- ===== POC 验证依赖（仅 test 作用域，不进入生产构建） ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Surefire 3.x 启动 JUnit5 引擎所需；缺失会导致 jupiter 测试被静默忽略（0 tests） -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- 根 pom 非 spring-boot-starter-parent，未管理 surefire；显式声明 3.5.5 以驱动 JUnit5 测试。仅验证用，不影响生产构建。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.5</version>
            </plugin>
        </plugins>
    </build>
</project>
