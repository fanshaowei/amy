<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.amy</groupId>
        <artifactId>amy-common</artifactId>
        <version>3.6.8</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>amy-common-log</artifactId>

    <description>
        amy-common-log日志记录
    </description>

    <dependencies>

        <!-- amy Common Security -->
        <dependency>
            <groupId>com.amy</groupId>
            <artifactId>amy-common-security</artifactId>
        </dependency>

        <!-- 链路追踪：桥接 + Boot 4 自动配置集中在此，依赖本模块的服务自动获得。
             Boot 4 已把 tracing 自动配置从 actuator 移出，只加 bridge 不会创建 Tracer / 写 MDC。 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>

    </dependencies>
</project>
